---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import SeriesNavigation from "../../components/SeriesNavigation.astro";
import { buildSeriesLookup } from "../../lib/series";

export async function getStaticPaths() {
    const entries = await getCollection("posts");
    const series = buildSeriesLookup(await getCollection("series"), entries);
    return entries
        .filter(({ data }) => !data.draft)
        .map((entry) => ({
            params: { slug: entry.data.slug },
            props: { entry, series: series.get(entry.id) },
        }));
}
const { entry, series } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout
    title={entry.data.title}
    description={entry.data.description || entry.data.excerpt}
>
    <article class="article">
        <nav aria-label="Breadcrumb">
            <a href="/">Blog</a>
        </nav>
        <h1>{entry.data.title}</h1>
        <p class="muted">
            <time datetime={entry.data.published}>{entry.data.published}</time>
        </p>
        {entry.data.categories?.length && (
            <p>Categories: {entry.data.categories.join(", ")}</p>
        )}
        {entry.data.tags?.length && <p>Tags: {entry.data.tags.join(", ")}</p>}
        {series && <SeriesNavigation series={series} variant="overview" />}
        <Content />
        {series && <SeriesNavigation series={series} variant="adjacent" />}
    </article>
</SiteLayout>
