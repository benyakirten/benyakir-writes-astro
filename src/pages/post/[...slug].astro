---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
    const entries = await getCollection("posts", ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.data.slug },
        props: { entry },
    }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout
    title={entry.data.title}
    description={entry.data.description || entry.data.excerpt}
>
    <article class="article">
        <nav aria-label="Breadcrumb">
            <a href="/blog/">Blog</a>
        </nav>
        <h1>{entry.data.title}</h1>
        <p class="muted">
            <time datetime={entry.data.published}>{entry.data.published}</time>
        </p>
        {entry.data.categories?.length && (
            <p>Categories: {entry.data.categories.join(", ")}</p>
        )}
        {entry.data.tags?.length && <p>Tags: {entry.data.tags.join(", ")}</p>}
        <Content />
    </article>
</SiteLayout>
