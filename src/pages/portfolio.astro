---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const projectImages = Object.keys(
    import.meta.glob("/public/images/projects/*"),
);
const projects = (await getCollection("projects", ({ data }) => !data.draft))
    .filter(
        ({ data }) =>
            data.title === "Benyakir Writes" ||
            data.firstReleased > "2023-01-01",
    )
    .sort((a, b) => b.data.firstReleased.localeCompare(a.data.firstReleased))
    .map((entry) => {
        const imageName = entry.data.title.replace(/\s/g, "_").toLowerCase();
        const image = projectImages.find(
            (file) =>
                file
                    .split("/")
                    .pop()
                    ?.replace(/\.[^.]+$/, "")
                    .toLowerCase() === imageName,
        );
        return {
            ...entry,
            data: {
                ...entry.data,
                excerpt:
                    entry.data.excerpt ||
                    entry.data.description ||
                    entry.body?.trim().split(/\n\s*\n/)[0],
                image: entry.data.image ?? image?.replace(/^\/public/, ""),
            },
        };
    });
const tabs = [
    { id: "projects", label: "Recent Projects" },
    { id: "history", label: "Work History" },
    { id: "bio", label: "About Me" },
];
const history = [
    {
        title: "Software Engineer, Frontend",
        company: "Reddit",
        start: "2026-08-04",
        points: [
            "Promoted from contract UX Designer to full-time Software Engineer after 9 months, continuing development of frontend systems while expanding into full-stack engineering with React and Go.",
        ],
    },
    {
        title: "UX Designer",
        company: "Reddit",
        start: "2025-11-20",
        end: "2026-08-03",
        points: [
            "Designed and developed a Lit-based UI component system to standardize frontend development across products, prioritizing accessibility, native web standards, Go template compatibility, HTMX integration, and maintainability.",
            "Delivered full-stack product features by integrating shared UI components into client applications, building frontend experiences, and contributing to backend services in Go.",
            "Led modernization efforts for a React application, improving performance, testing infrastructure, developer experience, and accessibility to WCAG AA standards while expanding product functionality through frontend and backend contributions.",
        ],
    },
    {
        title: "Independent Contractor",
        company: "SpringBlock",
        start: "2023-10-01",
        end: "2025-11-01",
        points: [
            "Planned and executed migration scheme to move data from legacy Oracle database to normalized Postgres database",
            "Create dynamic no-build frontend with JSDoc, Jinja templates and HTMX",
            "Designed and implemented Shopify Remix app with caching layer between external Postgres database and Shopify Admin GraphQL API",
        ],
    },
    {
        title: "Frontend Engineer",
        company: "Thread",
        start: "2022-02-01",
        end: "2023-07-01",
        points: [
            "Created customer-facing and internal web applications using Svelte in collaboration with product managers and designers",
            "Authored image inspection tool with annotations, comments and socialization feature based on requirements of ML engineers, product managers and customers",
            "Aligned with backend developers to develop new features and modernize infrastructure using Golang and SQL",
            "Led efforts to ensure software quality and prevent regression by creating extensive utilities for integration testing",
            "Built internal tooling in Python and Bash to increase developer velocity",
        ],
    },
    {
        title: "Web Developer",
        company: "The Saint Bridged Vineyard Press",
        start: "2020-09-01",
        end: "2022-02-01",
        points: [
            "Designed responsive websites for client discoverability with an emphasis on SEO and accessibility",
            "Developed custom WordPress themes and plugins to meet client needs",
            "Managed hosting and domain registration for clients",
        ],
    },
];
const monthYear = (date: string) =>
    new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    });
const resume =
    "https://03xfnwg50d.ufs.sh/f/jl5ip7RNwFcASrICw9HdO6LH8Js1NtXGIEiY2zhglbToa4PM";
---

<SiteLayout
    title="Portfolio"
    description="My developer portfolio, including only my best and most up-to-date projects."
>
    <div class="portfolio-content" data-portfolio>
        <div
            class="portfolio-shapes"
            data-portfolio-shapes
            aria-hidden="true"
        ></div>
        <header class="portfolio-header">
            <h1 class="lead-heading">Portfolio</h1>
        </header>
        <div class="centralized-item">
            <div class="portfolio-tabs">
                <div
                    class="tab-list"
                    role="tablist"
                    aria-label="Portfolio Sections"
                    data-portfolio-tabs
                >
                    <span
                        class="tab-indicator"
                        data-indicator
                        aria-hidden="true"
                    ></span>
                    {tabs.map(({ id, label }) => (
                        <button
                            id={`tab-${id}`}
                            type="button"
                            role="tab"
                            aria-selected={id === "bio"}
                            tabindex={id === "bio" ? 0 : -1}
                            aria-controls={`panel-${id}`}
                            data-section={id}
                        >
                            <span>{label}</span>
                        </button>
                    ))}
                </div>
                <section>
                    <div
                        id="panel-projects"
                        role="tabpanel"
                        aria-labelledby="tab-projects"
                        tabindex="0"
                        hidden
                    >
                        <ul class="recent-projects">
                            {projects.map((entry) => (
                                <ProjectCard entry={entry} />
                            ))}
                        </ul>
                    </div>
                    <div
                        id="panel-history"
                        role="tabpanel"
                        aria-labelledby="tab-history"
                        tabindex="0"
                        hidden
                    >
                        <ul class="work-history">
                            {history.map((job) => (
                                <li>
                                    <article class="work-history-item">
                                        <p class="work-position">
                                            <span>{job.title}</span>
                                            <span class="position-at">at</span>
                                            <span class="position-company">
                                                {job.company}
                                            </span>
                                        </p>
                                        <div class="work-dates iconed-text">
                                            <svg
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
                                                />
                                            </svg>
                                            <span>
                                                <time datetime={job.start}>
                                                    {monthYear(job.start)}
                                                </time>{" "}
                                                -{" "}
                                                {job.end ? (
                                                    <time datetime={job.end}>
                                                        {monthYear(job.end)}
                                                    </time>
                                                ) : (
                                                    "Present"
                                                )}
                                            </span>
                                        </div>
                                        <ul class="job-points">
                                            {job.points.map((point) => (
                                                <li>{point}.</li>
                                            ))}
                                        </ul>
                                    </article>
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div
                        id="panel-bio"
                        role="tabpanel"
                        aria-labelledby="tab-bio"
                        tabindex="0"
                    >
                        <div class="about-me">
                            <div class="profile">
                                <img
                                    class="profile-image"
                                    src="/images/profile_picture.png"
                                    alt="Ben Horowitz"
                                    width="80"
                                    decoding="async"
                                />
                                <p class="profile-name">
                                    <span class="name">Ben Horowitz</span>
                                    <span>Full Stack Developer</span>
                                </p>
                            </div>
                            <p>
                                I am a passionate full-stack web developer with
                                four years of experience building every part of
                                web applications. I am eternally curious, a
                                quick learner, self-motivated and a team player.
                                I use every frontend technology, including
                                React, Vue, Angular, Svelte and vanilla
                                JavaScript. I also work with databases, Python,
                                Node, Go, Rust and Elixir.
                            </p>
                            <p>
                                I studied at the University of Colorado Boulder
                                for my undergraduate, where I studied Classics,
                                Linguistics and Italian (graduated{" "}
                                <em>Summa cum Laude</em>). I have been a member
                                of Phi Beta Kappa since 2010. I studied for my
                                Masters in Italian Language at Middlebury
                                College and lived in Italy for two years
                                (2014-2016).
                            </p>
                            <p>
                                I speak Italian fluently, studied Latin and
                                Greek and used to converse in French (though it
                                has been more than a decade since I last used
                                it). I worked as a writer and editor prior to
                                becoming a developer. Much of the same passion
                                drives me in both fields: the desire to create,
                                the intense curiosity of how all things work,
                                the need for both long-term planning and quick
                                thinking, and the ability to work independently,
                                be a team player and become a leader as the
                                situation demands.
                            </p>
                            <div class="profile-links">
                                <a
                                    class="profile-link iconed-text"
                                    href="mailto:ben@benyakiredits.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        aria-hidden="true"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                                        />
                                    </svg>
                                    <span>Email</span>
                                </a>
                                <a
                                    class="profile-link iconed-text"
                                    href={resume}
                                    download="Resume - Ben Horowitz.pdf"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        aria-hidden="true"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                                        />
                                    </svg>
                                    <span>Resume</span>
                                </a>
                                <a
                                    class="profile-link iconed-text"
                                    href="https://github.com/benyakirten"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <img
                                        src="/images/social/Github.svg"
                                        alt=""
                                        width="24"
                                        height="24"
                                        loading="lazy"
                                    />
                                    <span>GitHub</span>
                                </a>
                                <a
                                    class="profile-link iconed-text"
                                    href="https://www.linkedin.com/in/ben-horowitz-93609b8a/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <img
                                        src="/images/social/LinkedIn.png"
                                        alt=""
                                        width="24"
                                        height="24"
                                        loading="lazy"
                                    />
                                    <span>LinkedIn</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
        <template data-portfolio-shape>
            <svg
                class="background-shape"
                viewBox="0 0 100 100"
                width="40"
                height="40"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <circle cx="50" cy="50" r="40" />
                <path d="M50 10V90M10 50H90M27 73L73 27" />
            </svg>
        </template>
        <template data-portfolio-shape>
            <svg
                class="background-shape"
                viewBox="0 0 100 100"
                width="40"
                height="40"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <polygon />
            </svg>
        </template>
        <template data-portfolio-shape>
            <svg
                class="background-shape line-shape"
                viewBox="0 0 100 100"
                width="80"
                height="80"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M20,50 C40,10 60,90 80,50 S120,10 140,50 C160,90 180,10 200,50" />
            </svg>
        </template>
        <template data-portfolio-shape>
            <svg
                class="background-shape line-shape"
                viewBox="0 0 100 100"
                width="80"
                height="80"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M10 50 C30 10, 70 90, 90 50" />
            </svg>
        </template>
    </div>
</SiteLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const portfolio =
            document.querySelector<HTMLElement>("[data-portfolio]");
        if (!portfolio) return;

        const controller = new AbortController();
        const { signal } = controller;
        document.addEventListener(
            "astro:before-swap",
            () => controller.abort(),
            {
                once: true,
                signal,
            },
        );
        const tabList = portfolio?.querySelector<HTMLElement>(
            "[data-portfolio-tabs]",
        );
        const buttons = Array.from(
            tabList?.querySelectorAll<HTMLButtonElement>("[role=tab]") ?? [],
        );
        const panels = Array.from(
            portfolio?.querySelectorAll<HTMLElement>("[role=tabpanel]") ?? [],
        );
        const indicator =
            tabList?.querySelector<HTMLElement>("[data-indicator]");

        function selectSection(
            id: string | null,
            updateQuery = false,
            focus = false,
        ) {
            const selected =
                buttons.find((button) => button.dataset.section === id) ??
                buttons.find((button) => button.dataset.section === "bio");
            if (!selected || !tabList) return;
            buttons.forEach((button) => {
                const active = button === selected;
                button.setAttribute("aria-selected", String(active));
                button.tabIndex = active ? 0 : -1;
            });
            panels.forEach((panel) => {
                panel.hidden =
                    panel.id !== selected.getAttribute("aria-controls");
            });
            if (indicator) {
                indicator.style.left = `${selected.offsetLeft}px`;
                indicator.style.top = `${selected.offsetTop}px`;
                indicator.style.width = `${selected.offsetWidth}px`;
                indicator.style.height = `${selected.offsetHeight}px`;
            }
            if (updateQuery) {
                const url = new URL(window.location.href);
                url.searchParams.set("section", selected.dataset.section!);
                window.history.replaceState(window.history.state, "", url);
            }
            if (focus) selected.focus();
        }

        const readSection = () => {
            if (signal.aborted) return;
            selectSection(
                new URLSearchParams(window.location.search).get("section"),
            );
        };
        buttons.forEach((button) => {
            button.addEventListener(
                "click",
                () => selectSection(button.dataset.section!, true),
                { signal },
            );
            button.addEventListener(
                "keydown",
                (event) => {
                    let index = buttons.indexOf(button);
                    switch (event.key) {
                        case "ArrowLeft":
                        case "ArrowUp":
                            index =
                                (index + buttons.length - 1) % buttons.length;
                            break;
                        case "ArrowRight":
                        case "ArrowDown":
                            index = (index + 1) % buttons.length;
                            break;
                        case "Home":
                            index = 0;
                            break;
                        case "End":
                            index = buttons.length - 1;
                            break;
                        default:
                            return;
                    }
                    event.preventDefault();
                    selectSection(buttons[index].dataset.section!, true, true);
                },
                { signal },
            );
        });
        readSection();
        window.addEventListener("popstate", readSection, { signal });
        if (tabList) {
            const observer = new ResizeObserver(readSection);
            observer.observe(tabList);
            signal.addEventListener("abort", () => observer.disconnect(), {
                once: true,
            });
        }
        document.fonts.ready.then(readSection);

        // Reproduce the source's sparse 100px grid of drifting decorative SVGs.
        const shapes = portfolio?.querySelector<HTMLElement>(
            "[data-portfolio-shapes]",
        );
        const templates = Array.from(
            portfolio?.querySelectorAll<HTMLTemplateElement>(
                "[data-portfolio-shape]",
            ) ?? [],
        );
        if (portfolio && shapes && templates.length) {
            const columns = Math.floor(portfolio.clientWidth / 100);
            const rows = Math.floor(portfolio.clientHeight / 100);
            for (let row = 0; row < rows; row++) {
                const count = Math.ceil(
                    Math.min(
                        Math.floor(Math.random() * columns),
                        columns * 0.2,
                    ),
                );
                const occupied = new Set<number>();
                while (occupied.size < count)
                    occupied.add(Math.floor(Math.random() * columns));
                for (const column of occupied) {
                    const template =
                        templates[Math.floor(Math.random() * templates.length)];
                    const shape = template.content.firstElementChild!.cloneNode(
                        true,
                    ) as SVGSVGElement;
                    shape.style.left = `${column * 100 + 50}px`;
                    shape.style.top = `${row * 100 + 50}px`;
                    shape.style.setProperty(
                        "--drift-x",
                        `${Math.floor(Math.random() * 10) - 5}rem`,
                    );
                    shape.style.setProperty(
                        "--drift-y",
                        `${Math.floor(Math.random() * 10) - 5}rem`,
                    );
                    if (shape.classList.contains("line-shape")) {
                        shape.style.setProperty(
                            "--rotation",
                            `${(Math.floor(Math.random() * 3) + 3) * -60}deg`,
                        );
                    }
                    const polygon = shape.querySelector("polygon");
                    if (polygon)
                        polygon.setAttribute(
                            "points",
                            Array.from(
                                { length: Math.floor(Math.random() * 6) + 6 },
                                () =>
                                    `${Math.floor(Math.random() * 100)},${Math.floor(Math.random() * 100)}`,
                            ).join(" "),
                        );
                    shapes.append(shape);
                }
            }
        }
    });
</script>

<style>
    :global(.page-content:has(> .portfolio-content)) {
        padding: 0;
    }
    .portfolio-content {
        position: relative;
        isolation: isolate;
        height: 100vh;
        overflow: auto;
        padding: 2rem 1rem;
        color: var(--text);
        --tab-bg: var(--portfolio-tab-bg);
        --tab-text: var(--portfolio-tab-text);
        --selected-tab-bg: var(--portfolio-selected-tab-bg);
        --selected-tab-text: var(--portfolio-selected-tab-text);
    }
    .portfolio-header {
        display: grid;
        gap: 0.8rem;
        justify-content: center;
        font-family: var(--font-ui);
    }
    .portfolio-header h1 {
        z-index: 1;
    }
    .centralized-item {
        position: relative;
        width: 80%;
        margin: 2.4rem auto;
    }
    .portfolio-tabs {
        display: grid;
        gap: 0.8rem;
        font-family: var(--font-ui);
        font-size: 1rem;
        line-height: 1.5rem;
    }
    .tab-list {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.8rem;
        border-radius: 0.4rem;
        overflow: hidden;
        background: var(--tab-bg);
    }
    .tab-list button {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 31%;
        color: var(--tab-text);
        transition: color 200ms ease;
    }
    .tab-list button span {
        white-space: nowrap;
    }
    .tab-list button[aria-selected="true"] {
        color: var(--selected-tab-text);
    }
    .tab-indicator {
        position: absolute;
        left: calc(66% - 0.8rem);
        top: 0.8rem;
        width: calc((100% - 1.6rem) * 0.31);
        height: 1.5rem;
        border-radius: 0.4rem;
        background: var(--selected-tab-bg);
        transition:
            left 200ms ease,
            top 200ms ease,
            width 200ms ease,
            height 200ms ease;
        pointer-events: none;
    }
    .tab-list:focus-within .tab-indicator {
        outline: 1px solid var(--selected-tab-bg);
        outline-offset: 2px;
    }
    [role="tabpanel"][hidden] {
        display: none;
    }
    .recent-projects {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.6rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .recent-projects > :global(li) {
        position: relative;
        z-index: 1;
        background: var(--page-bg);
    }
    .work-history {
        display: grid;
        gap: 1.6rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .work-history-item {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 0.4rem;
        padding: 0.8rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--page-bg);
    }
    .work-position {
        display: flex;
        align-items: center;
        gap: 1ch;
        margin: 0;
    }
    .work-position > span {
        font-size: 1.125rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .work-dates {
        margin-left: -2px;
    }
    .iconed-text {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .iconed-text > svg,
    .iconed-text > img {
        flex: 0 0 1.5rem;
        width: 1.5rem;
        height: 1.5rem;
    }
    .iconed-text > img[src$="/Github.svg"] {
        filter: var(--monochrome-filter);
    }
    .job-points {
        margin: 0.8rem 0 0;
        padding-left: 0.8rem;
        list-style: disc;
    }
    .job-points li + li {
        margin-top: 0.4rem;
    }
    .about-me {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 0.8rem;
        padding: 0.8rem;
        border: 1px solid var(--border);
        border-radius: 0.8rem;
        background: var(--page-bg);
    }
    .about-me p {
        margin: 0;
    }
    .profile {
        display: flex;
        gap: 0.8rem;
        margin: 0.8rem 0;
    }
    .profile-image {
        display: block;
        align-self: flex-start;
        width: 80px;
        height: auto;
    }
    .profile-name {
        display: grid;
        gap: 0.4rem;
    }
    .profile-name .name {
        font-size: 1.25rem;
        font-weight: 700;
    }
    .profile-links {
        display: grid;
        gap: 0.4rem;
    }
    .profile-link {
        position: relative;
        width: max-content;
        max-width: 100%;
    }
    .profile-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--link);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 200ms ease;
    }
    .profile-link:hover::after,
    .profile-link:focus-visible::after {
        transform: scaleX(1);
    }
    .portfolio-shapes {
