---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

import { getPublicImageSize } from "../../lib/media";
export async function getStaticPaths() {
    const entries = await getCollection("books", ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.data.slug },
        props: { entry },
    }));
}
const { entry } = Astro.props;
const { data } = entry;
const coverSize = await getPublicImageSize(data.cover);
const { Content } = await render(entry);

const published = new Date(`${data.published}T12:00:00Z`).toLocaleDateString(
    "en-US",
    { year: "numeric", month: "long", day: "2-digit", timeZone: "UTC" },
);
---

<SiteLayout title={data.title} description={data.description || data.excerpt}>
    <article class="book-page">
        {data.cover && (
            <div class="book-cover">
                <img
                    src={data.cover}
                    width={coverSize?.width}
                    height={coverSize?.height}
                    alt={data.coverAlt || `${data.title} Cover`}
                    loading="eager"
                    decoding="async"
                />
            </div>
        )}
        <header class="book-header">
            <h1>{data.title}</h1>
            <div class="published-date">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
                    />
                </svg>
                <time datetime={data.published}>Published: {published}</time>
            </div>
            {data.purchaseLinks.length > 0 && (
                <ul class="purchase-links">
                    <li>Available for purchase&nbsp;</li>
                    {data.purchaseLinks.map((link, i) => (
                        <li>
                            on{" "}
                            <a href={link.url} rel="external">
                                {link.name}
                            </a>
                            {i < data.purchaseLinks.length - 1 && ", "}
                        </li>
                    ))}
                </ul>
            )}
        </header>
        <ul class="book-content">
            {data.coverDesigner && (
                <li>
                    <section
                        class="detail-card"
                        aria-labelledby="designer-heading"
                    >
                        <h2 id="designer-heading">Cover Designer</h2>
                        <div class="designer-details">
                            <p class="designer-name">
                                Artist: {data.coverDesigner.name}
                            </p>
                            {data.coverDesigner.bio && (
                                <p>{data.coverDesigner.bio}</p>
                            )}
                            {data.coverDesigner.links.length > 0 && (
                                <ul>
                                    {data.coverDesigner.links.map((link) => (
                                        <li>
                                            <a href={link.url} rel="external">
                                                {link.name}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    </section>
                </li>
            )}
            <li>
                <section class="detail-card" aria-labelledby="blurb-heading">
                    <h2 id="blurb-heading">Blurb</h2>
                    <div class="wp-content">
                        <Content />
                    </div>
                </section>
            </li>
        </ul>
    </article>
</SiteLayout>
<style>
    .book-page {
        min-width: 0;
        font-size: 1rem;
        line-height: normal;
    }
    .book-page p,
    .book-page ul {
        margin: 0;
        padding: 0;
    }
    .book-cover {
        display: flex;
        justify-content: center;
        margin-bottom: 1.6rem;
    }
    .book-cover img {
        display: block;
        width: 400px;
        max-width: 100%;
        height: auto;
    }
    .book-header {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 0.8rem;
    }
    h1 {
        margin: 0;
        padding: 0.4rem 0;
        font-size: 2.25rem;
        line-height: 2.5rem;
    }
    h1,
    h2 {
        background: linear-gradient(
            to right,
            var(--heading-start) 40%,
            var(--heading-end)
        );
        background-size: 300%;
        background-clip: text;
        color: transparent;
        transition: background-position 500ms ease;
    }
    h1:hover,
    h2:hover {
        background-position: right;
    }
    h2 {
        margin: 0 0 1.6rem;
        padding: 0;
        font-size: 1.5rem;
        line-height: 2rem;
    }
    .published-date {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text);
    }
    .published-date svg {
        flex: 0 0 1.5rem;
        width: 1.5rem;
        height: 1.5rem;
    }
    .purchase-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }
    .book-header .purchase-links {
        margin-bottom: 0.8rem;
    }
    .book-content {
        display: grid;
        gap: 0.8rem;
        list-style: none;
    }
    .detail-card {
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        padding: 0.8rem;
        background: var(--page-bg);
    }
    .designer-details {
        display: grid;
        gap: 0.8rem;
    }
    .designer-name {
        font-size: 1.25rem;
        line-height: 1.75rem;
    }
    a,
    .wp-content :global(a) {
        color: var(--link);
        background: linear-gradient(currentColor, currentColor) no-repeat 0
            100% / 0 2px;
        transition: background-size 300ms ease;
    }
    a:hover,
    a:focus-visible,
    .wp-content :global(a:hover),
    .wp-content :global(a:focus-visible) {
        background-size: 100% 2px;
    }
    .wp-content {
        font-size: 1.25rem;
        line-height: 1.75rem;
    }
    .wp-content :global(p),
    .wp-content :global(code),
    .wp-content :global(figure) {
        margin: 0 0 1.6rem;
    }
    .wp-content :global(h1),
    .wp-content :global(h2),
    .wp-content :global(h3),
    .wp-content :global(h4),
    .wp-content :global(h5),
    .wp-content :global(h6) {
        margin: 0;
        padding: 1.6rem 0;
        font-family: var(--font-ui);
        background: linear-gradient(
            to right,
            var(--heading-start) 40%,
            var(--heading-end)
        );
        background-size: 300%;
        background-clip: text;
        color: transparent;
    }
    .wp-content :global(ul),
    .wp-content :global(ol),
    .wp-content :global(li) {
        margin-left: 0.8rem;
    }
    .wp-content :global(a) {
        color: var(--link);
    }
    .wp-content :global(img) {
        max-width: 100%;
        height: auto;
    }

    @media (max-width: 576px) {
        h1 {
            font-size: 1.875rem;
            line-height: 2.25rem;
        }
        h2 {
            font-size: 1.25rem;
            line-height: 1.75rem;
        }
        .wp-content {
            font-size: 1.125rem;
        }
    }
</style>
