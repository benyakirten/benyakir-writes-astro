---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('books', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={entry.data.title} description={entry.data.description || entry.data.excerpt}>
  <article class="article">
    <nav aria-label="Breadcrumb"><a href="/author/">Books &amp; Stories</a></nav>
    <h1>{entry.data.title}</h1>
    <p class="muted"><time datetime={entry.data.published}>{entry.data.published}</time></p>
    {entry.data.cover && <img src={entry.data.cover} alt={entry.data.coverAlt || `Cover of ${entry.data.title}`} loading="eager" />}
    <Content />
    {entry.data.purchaseLinks.length > 0 && <section><h2>Purchase</h2><ul>{entry.data.purchaseLinks.map((link) => <li><a href={link.url} rel="external">{link.name}</a></li>)}</ul></section>}
    {entry.data.coverDesigner && <section><h2>Cover design</h2><p>{entry.data.coverDesigner.name}</p>{entry.data.coverDesigner.bio && <p>{entry.data.coverDesigner.bio}</p>}</section>}
    {entry.data.relatedStories.length > 0 && <section><h2>Related stories</h2><ul>{entry.data.relatedStories.map((slug) => <li><a href={`/story/${slug}/`}>{slug}</a></li>)}</ul></section>}
  </article>
</SiteLayout>
