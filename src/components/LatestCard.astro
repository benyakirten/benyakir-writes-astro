---
import type { CollectionEntry } from "astro:content";
import { contentPath } from "../config";
import type { PostSeries } from "../lib/series";

interface Props {
    entry: CollectionEntry<"posts">;
    series?: PostSeries;
}
const { entry, series } = Astro.props;
const { data } = entry;
const tags = [...data.tags].sort((a, b) => a.localeCompare(b));
const categories = data.categories.filter(
    (category) => category.toLowerCase() !== "uncategorized",
);
const activeCategory =
    categories.find((category) => category !== "Ben's Blogs") ??
    categories[0] ??
    "Unknown";
const text = (entry.body ?? "")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_`>#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
const summary =
    data.excerpt || data.description || text || "Click to read more.";
const excerpt =
    summary.length > 300
        ? summary.substring(0, 300).replace(/\s\S*$/, "...")
        : summary;
const published = new Date(`${data.published}T12:00:00Z`).toLocaleDateString(
    "en-US",
    {
        year: "numeric",
        month: "long",
        day: "2-digit",
        timeZone: "UTC",
    },
);
---

<li class="latest-card-item">
    <a class="latest-card-link" href={contentPath("posts", data.slug)}>
        <article class="latest-card">
            <span
                class="latest-card-arrow"
                data-arrow
                aria-hidden="true"
            ></span>
            <p class="latest-category">{activeCategory}</p>
            <div class="latest-tags">
                <div class="latest-desktop-tags">
                    {tags.slice(0, 2).map((tag) => (
                        <span class="tag-pill">{tag}</span>
                    ))}
                    {data.tags.length > 2 && (
                        <span class="tag-pill">
                            {data.tags.length - 2} other
                            {data.tags.length - 2 > 1 ? "s" : ""}
                        </span>
                    )}
                </div>
                {data.tags.length > 0 && (
                    <span class="tag-pill latest-mobile-tags">
                        {data.tags.length} tag{data.tags.length > 1 ? "s" : ""}
                    </span>
                )}
            </div>
            <h3 class="latest-title">{data.title}</h3>
            {series && (
                <p class="latest-series">
                    <strong>Series: {series.title}</strong>
                    <span>
                        {" "}
                        · Part {series.position} of {series.posts.length}
                    </span>
                </p>
            )}
            <div class="latest-excerpt">{excerpt}</div>
            <div class="latest-card-dates">
                <svg
                    class="date-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
                    />
                </svg>
                <time datetime={data.published}>Published: {published}</time>
            </div>
        </article>
    </a>
</li>
